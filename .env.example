# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token-here

# ── Optional ──────────────────────────────────────────────────────────────────
# Guild ID for faster slash command sync (recommended for development)
DISCORD_GUILD_ID=

# SQLite database path (Docker: override with /app/data/ctf_bot.db via env)
DATABASE_PATH=ctf_bot.db

# Scoreboard polling interval in seconds
SCOREBOARD_POLL_SECONDS=30

# Number of teams shown in scoreboard updates
SCOREBOARD_TOP_N=10

# Your team name for scoreboard tracking (optional)
SCOREBOARD_TEAM_NAME=

# Timezone for displaying event times.
# Accepts IANA names (Asia/Ho_Chi_Minh, Europe/Berlin) or UTC±N offsets (UTC+7, UTC-5).
TIMEZONE=UTC+7

# Password required to run /ctf remove (leave empty to disable the command)
CTF_REMOVE_PASSWORD=

# Fernet encryption key for storing auth tokens securely at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Auto-poll CTFd scoreboard configs for newly released challenges (0 = disabled)
CTFD_POLL_INTERVAL_MINUTES=0

# Auto-post database backups to the private BOT/#backup channel (0 = disabled)
AUTO_BACKUP_INTERVAL_HOURS=0
